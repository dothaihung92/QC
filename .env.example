# Sao chép file này thành .env rồi điền thông tin.
# Để trống FB_PAGE_ID / FB_PAGE_ACCESS_TOKEN → phần mềm chạy thử (không gửi gì lên Facebook).

# ID Fanpage (Trang → Giới thiệu → Minh bạch về Trang, hoặc trong Meta Business Suite)
FB_PAGE_ID=
# Page Access Token dài hạn, có quyền pages_manage_posts, pages_read_engagement,
# pages_manage_engagement, pages_messaging
FB_PAGE_ACCESS_TOKEN=
# App Secret (developers.facebook.com → App → Settings → Basic) — dùng để xác thực webhook
FB_APP_SECRET=
# Chuỗi tự đặt, nhập giống hệt khi đăng ký webhook trên Meta
FB_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# Mặc định KHÔNG cần đăng nhập vào bảng điều khiển (chỉ chạy trên máy bạn).
# Chỉ bật nếu đưa phần mềm ra ngoài Internet (vd qua cloudflared tunnel):
# DASHBOARD_LOGIN=true
# ADMIN_PASSWORD=matkhaucuaban
HOST=127.0.0.1
PORT=8787
